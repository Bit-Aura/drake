{
  "openapi": "3.0.1",
  "info": {
    "title": "Dell iDRAC9 Redfish API",
    "version": "7.00.00.00"
  },
  "paths": {
    "/redfish/v1/Systems/System.Embedded.1": {
      "get": {
        "operationId": "GET_ComputerSystem",
        "summary": "Get system hardware facts and health state",
        "tags": ["Systems"],
        "responses": {
          "200": {
            "description": "System details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Id": {"type": "string"},
                    "Name": {"type": "string"},
                    "Health": {"type": "string"},
                    "PowerState": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/redfish/v1/Managers/iDRAC.Embedded.1/Oem/Dell/DellAttributes": {
      "get": {
        "operationId": "GET_DellAttributes",
        "summary": "Get OEM Dell attributes like BIOS, NIC, RAID configurations",
        "tags": ["Managers"],
        "responses": {
          "200": {
            "description": "Dell Attributes"
          }
        }
      },
      "patch": {
        "operationId": "PATCH_DellAttributes",
        "summary": "Update OEM Dell attributes",
        "tags": ["Managers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Attributes": {"type": "object"}
                }
              }
            }
          }
        },
        "responses": {
          "204": {"description": "Updated"}
        }
      }
    },
    "/redfish/v1/UpdateService/Actions/UpdateService.SimpleUpdate": {
      "post": {
        "operationId": "POST_SimpleUpdate",
        "summary": "Perform a simple firmware update",
        "tags": ["UpdateService"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ImageURI": {"type": "string"},
                  "TransferProtocol": {"type": "string"}
                },
                "required": ["ImageURI"]
              }
            }
          }
        },
        "responses": {
          "202": {"description": "Update job accepted"}
        }
      }
    },
    "/redfish/v1/Chassis/{ChassisId}/PowerSubsystem/PowerSupplies/{PowerSupplyId}/Metrics": {
      "get": {
        "operationId": "GET_PowerSupplyMetrics",
        "summary": "Get power supply metrics",
        "tags": ["Power"],
        "parameters": [
          {
            "name": "ChassisId",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "PowerSupplyId",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Mocked Power Metrics Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "InputVoltage": {"type": "number", "example": 220.5},
                    "PowerConsumedWatts": {"type": "number", "example": 350.2},
                    "Status": {
                      "type": "object",
                      "properties": {
                        "Health": {"type": "string", "example": "OK"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/redfish/v1/Systems/{ComputerSystemId}/Processors/{ProcessorId}/FPGA/Oem/Dell/ThermalMetrics": {
      "get": {
        "operationId": "GET_ThermalMetrics",
        "summary": "Get thermal metrics for a processor FPGA",
        "tags": ["Thermal"],
        "parameters": [
          { "name": "ComputerSystemId", "in": "path", "required": true, "schema": {"type": "string"} },
          { "name": "ProcessorId", "in": "path", "required": true, "schema": {"type": "string"} }
        ],
        "responses": {
          "200": {
            "description": "Mocked Thermal Metrics Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "TemperatureCelsius": {"type": "number", "example": 45.2},
                    "Status": {"type": "object", "properties": {"Health": {"type": "string", "example": "OK"}}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/redfish/v1/Systems/{ComputerSystemId}/Processors/{ProcessorId}/Oem/Dell/ThermalMetrics": {
      "get": {
        "operationId": "GET_ThermalMetricsNonFPGA",
        "summary": "Get thermal metrics for a processor",
        "tags": ["Thermal"],
        "parameters": [
          { "name": "ComputerSystemId", "in": "path", "required": true, "schema": {"type": "string"} },
          { "name": "ProcessorId", "in": "path", "required": true, "schema": {"type": "string"} }
        ],
        "responses": {
          "200": {
            "description": "Mocked Thermal Metrics Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "TemperatureCelsius": {"type": "number", "example": 48.9},
                    "Status": {"type": "object", "properties": {"Health": {"type": "string", "example": "OK"}}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/redfish/v1/Chassis/{ChassisId}/Thermal": {
      "get": {
        "operationId": "GET_ChassisThermal",
        "summary": "Get thermal metrics for the entire chassis",
        "tags": ["Thermal"],
        "parameters": [
          { "name": "ChassisId", "in": "path", "required": true, "schema": {"type": "string"} }
        ],
        "responses": {
          "200": {
            "description": "Mocked Chassis Thermal Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Fans": {"type": "array", "items": {"type": "object"}},
                    "Temperatures": {"type": "array", "items": {"type": "object", "properties": {"ReadingCelsius": {"type": "number", "example": 38.0}}}}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
