# ==============================================================================
# Dell MCP — Environment Variables (REQUIRED)
# ==============================================================================
# Copy this file to .env and fill in production values.
# The application will REFUSE TO START if any required variable is missing.

# --- Authentication & Security ---
DELL_MCP_API_KEY=your_secure_api_key_here
JWT_SECRET=your_jwt_signing_secret_here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- Executor Configuration ---
DELL_EXECUTOR_TYPE=prism              # prism | httpx | mock | omsdk
PRISM_URL=http://localhost:4010
MOCK_SERVER_URL=http://localhost:8000

# --- Compatibility Policy ---
DELL_COMPATIBILITY_POLICY=STRICT      # STRICT | WARN_ONLY | DISABLED

# --- Cache ---
DELL_CACHE_TTL=60                     # seconds (optional, defaults to 60)

# --- Admin Portal ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_production

# --- iDRAC Credentials ---
IDRAC_USER=root
IDRAC_PASSWORD=change_me_in_production

# --- OMSDK ---
OMSDK_SESSION_TOKEN=your_omsdk_token

# --- LLM / AI Integration ---
OPENAI_API_KEY=sk-your-openai-key
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:14b

# --- Server ---
PORT=8000                             # optional, defaults to 8000

# --- Legacy / Parser ---
DELL_SPEC_PATH=data/raw_specs
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
